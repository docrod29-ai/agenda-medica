rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function memberClinicId() {
      return get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId;
    }

    function isMember(clinicId) {
      return isAuth() && memberClinicId() == clinicId;
    }

    function isAdmin(clinicId) {
      return isAuth() &&
        get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId == clinicId &&
        get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.role == 'admin';
    }

    // Cualquier rol médico (medico o admin), NUNCA secretaria.
    // Crítico: solo médicos/admin pueden leer notas clínicas, recetas, órdenes
    // y datos clínicos sensibles. La asistente puede agendar pero NO ver expedientes.
    function isMedico(clinicId) {
      return isAuth() &&
        get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId == clinicId &&
        (get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.role == 'medico'
         || get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.role == 'admin');
    }

    // Staff clínico hospitalario: médico, admin, enfermería, farmacia, laboratorio.
    // Acceden al módulo de hospitalización (NO la secretaria/recepción/facturación).
    function isClinicoHospital(clinicId) {
      return isAuth() &&
        get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId == clinicId &&
        get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.role in ['medico', 'admin', 'enfermeria', 'farmacia', 'laboratorio'];
    }

    // Quién EMITE resultados de laboratorio: el laboratorio y el médico. NO
    // enfermería ni farmacia, que no producen el resultado. La lectura sigue
    // abierta a todo el staff clínico (necesitan ver los resultados).
    function isLabStaff(clinicId) {
      return isAuth() &&
        get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId == clinicId &&
        get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.role in ['medico', 'admin', 'laboratorio'];
    }

    /**
     * ¿La clínica puede CAPTURAR datos nuevos? Puerta del paywall en las reglas.
     *
     * El bloqueo de suscripción vencida vivía SOLO en React (`AccesoGate`), así
     * que saltándose ese componente desde la consola se seguía escribiendo. Esto
     * lo cierra en el servidor — pero con dos decisiones deliberadas:
     *
     *  - Solo bloquea ESCRITURA de datos nuevos, no la LECTURA. El expediente
     *    debe poder leerse aunque el pago falle (NOM-004: el médico tratante tiene
     *    derecho de acceso al registro). Cortar la lectura sería ilegal, no solo
     *    hostil.
     *  - FALLA-ABIERTO. Si el doc de la clínica no tiene `status` (documentos
     *    viejos, o el campo aún no escrito), NO se bloquea: atrapar a una clínica
     *    legítima por un campo ausente es peor que dejar pasar una escritura de
     *    una vencida. Solo se bloquea ante un estado terminal EXPLÍCITO.
     *
     * `paseLibre` (cuentas del dueño / cortesía) siempre puede escribir.
     */
    function clinicaPuedeEscribir(clinicId) {
      let c = get(/databases/$(database)/documents/clinics/$(clinicId)).data;
      let status = c.get('status', 'active');
      // Paywall del servidor: una PRUEBA vencida (status 'trial') deja de escribir tras
      // 1 día de gracia. Solo aplica a 'trial' — quien PAGA o tiene Stripe-trialing
      // queda en status 'active' (el webhook mapea trialing→active), así que NUNCA se
      // bloquea a un cliente al día. FALLA-ABIERTO: sin `trialEndsAtMs` (clínicas
      // viejas) no se bloquea; atrapar a una legítima por un campo ausente es peor.
      // El reloj se compara en epoch-ms (trialEndsAtMs) porque las reglas no parsean ISO.
      let trialMs = c.get('trialEndsAtMs', 0);
      let pruebaVencida = status == 'trial' && trialMs > 0
        && (trialMs + 86400000) < request.time.toMillis();   // +1 día de gracia
      return c.get('paseLibre', false) == true
        || (!(status in ['cancelled', 'canceled', 'suspended']) && !pruebaVencida);
    }

    // Clinic metadata (root)
    match /clinics/{clinicId} {
      allow read: if isMember(clinicId);
      // CREATE blindado: el alta legítima pasa por /api/clinic/crear (Admin SDK, que
      // ignora estas reglas), así que aquí solo llega el SDK cliente. Sin este
      // candado, cualquier cuenta autenticada podía crear su propia clínica con
      // `paseLibre:true`, `status:'active'`, todos los `modulos`, etc. — auto-
      // activándose sin pasar por Stripe (bypass de paywall/entitlements). Se exige
      // ser el dueño y se PROHÍBEN los campos de facturación/entitlement (solo los
      // asigna el servidor), igual que ya hace el `update`.
      // El alta legítima pasa por Admin SDK (ignora estas reglas). Este create SOLO lo
      // usaría el SDK cliente: se exige que arranque como PRUEBA con un reloj real y
      // ACOTADO (≤15 días), para cerrar el hueco de crearse una clínica sin reloj de
      // prueba que quedaba escribible para siempre (status ausente → 'active').
      allow create: if isAuth()
        && request.resource.data.get('ownerId', '') == request.auth.uid
        && request.resource.data.get('paseLibre', false) == false
        && request.resource.data.get('status', '') == 'trial'
        && request.resource.data.get('trialEndsAtMs', 0) > 0
        && request.resource.data.get('trialEndsAtMs', 0) <= request.time.toMillis() + 15 * 86400000
        // 'plan' también se bloquea: la creación legítima va por el servidor
        // (/api/clinic/crear, Admin SDK); un cliente que cree el doc directo no debe
        // poder auto-asignarse un plan (el comentario del server ya lo exigía).
        && !request.resource.data.keys().hasAny(
             ['modulos', 'paqueteId', 'stripeCustomerId', 'stripeSubscriptionId', 'plan']
           );
      // El admin de la clínica puede editar metadatos del doc raíz, PERO NUNCA los
      // campos de FACTURACIÓN/ENTITLEMENTS (plan, estado, prueba, Stripe, pase
      // libre, módulos/paquete). Esos SOLO los cambia el servidor (webhook Stripe
      // + consola del dueño con Admin SDK). Así el cliente no puede auto-activarse
      // ni desbloquear módulos que no pagó. Se usa get(...,default) para tolerar
      // documentos donde el campo aún no existe.
      allow update: if isAdmin(clinicId)
        && request.resource.data.get('plan', '')            == resource.data.get('plan', '')
        && request.resource.data.get('status', '')          == resource.data.get('status', '')
        && request.resource.data.get('trialEndsAt', '')     == resource.data.get('trialEndsAt', '')
        // trialEndsAtMs es el reloj REAL del paywall (clinicaPuedeEscribir lo lee).
        // Sin fijarlo, un admin extendía su prueba indefinidamente desde el cliente
        // (bypass del trial — auditoría maestra 2026-07 / reporte externo).
        && request.resource.data.get('trialEndsAtMs', 0)    == resource.data.get('trialEndsAtMs', 0)
        // ownerId es la raíz de la propiedad de la clínica: server-authoritative.
        && request.resource.data.get('ownerId', '')         == resource.data.get('ownerId', '')
        && request.resource.data.get('stripeCustomerId', '') == resource.data.get('stripeCustomerId', '')
        && request.resource.data.get('stripeSubscriptionId', '') == resource.data.get('stripeSubscriptionId', '')
        && request.resource.data.get('paseLibre', false)    == resource.data.get('paseLibre', false)
        && request.resource.data.get('modulos', [])         == resource.data.get('modulos', [])
        && request.resource.data.get('paqueteId', '')       == resource.data.get('paqueteId', '');
      allow delete: if false;

      match /appointments/{docId} {
        allow read: if isMember(clinicId);
        /**
         * BORRAR UNA CITA ES DEL MÉDICO (decisión del dueño, 2026-08-01).
         *
         * Cancelar CONSERVA el registro; borrar lo destruye, y el mostrador no
         * necesita destruir nada para hacer su trabajo: una cita que ya no va se
         * cancela, con su motivo y su rastro. La asistente conserva `update`, o
         * sea cancelar, marcar no-asistió y reagendar.
         */
        allow delete: if isMedico(clinicId);
        // Captura nueva sujeta al paywall; leer/actualizar/borrar lo existente no.
        // ANTI-FRAUDE DE CORTESÍA: marcar una cita como exenta (no cobrar) oculta una
        // deuda; por eso, al pasar `cobroExento` de false→true, se EXIGE que quede el
        // autor real (exentoPor == uid) y un motivo, igual que la anulación de cobros
        // (la validación del cliente en exentarCobro no basta: las rules son el borde).
        // Los demás updates (reagendar, etc.) no se ven afectados.
        allow update: if isMember(clinicId) && (
          !(resource.data.get('cobroExento', false) == false && request.resource.data.get('cobroExento', false) == true)
          || (
            request.resource.data.get('exentoPor', '') == request.auth.uid
            && request.resource.data.get('exentoMotivo', '') is string
            && request.resource.data.get('exentoMotivo', '').size() > 0
          )
        );
        // Al CREAR, si la cita nace exenta (cobroExento:true) se exige el mismo
        // control antifraude que en el update (autor real + motivo). Antes se podía
        // crear ya exenta y saltarse el guard de false→true (auditoría maestra 2026-07).
        allow create: if isMember(clinicId) && clinicaPuedeEscribir(clinicId) && (
          request.resource.data.get('cobroExento', false) == false
          || (
            request.resource.data.get('exentoPor', '') == request.auth.uid
            && request.resource.data.get('exentoMotivo', '') is string
            && request.resource.data.get('exentoMotivo', '').size() > 0
          )
        );
      }
      match /patients/{docId} {
        allow read: if isMember(clinicId);
        // La asistente puede EDITAR datos del paciente (contacto, demografía).
        allow update: if isMember(clinicId);
        /**
         * BORRAR UN EXPEDIENTE NO SE HACE DESDE EL NAVEGADOR. PUNTO.
         *
         * Estaba permitido al admin, y la salvaguarda que impide borrar un
         * expediente CON NOTAS FIRMADAS vivía en `deletePatientExpediente`… una
         * función sin un solo llamador. O sea: la protección NOM-004 estaba en
         * código muerto y la puerta abierta en las reglas, que es el único borde
         * real. Además, borrando sólo el paciente las notas firmadas quedaban
         * huérfanas: siguen protegidas, pero ya no cuelgan de nadie.
         *
         * El borrado legítimo existe y pasa por `/api/arco/cancelar`, que usa el
         * SDK admin: cuenta las notas firmadas, decide entre supresión y
         * bloqueo, y deja asiento en la bitácora. Ese camino no pasa por aquí.
         *
         * Nada en la interfaz borra pacientes desde el cliente, así que cerrar
         * esto no quita ninguna función: quita una puerta que sólo servía para
         * una consola del navegador.
         */
        allow delete: if false;
        allow create: if isMember(clinicId) && clinicaPuedeEscribir(clinicId);

        // Expediente Clínico Electrónico — notas del paciente
        // SECRETO MÉDICO: solo médicos/admin pueden leer o escribir notas clínicas.
        // La asistente NUNCA tiene acceso (NOM-004 + LFPDPPP datos sensibles).
        match /notas/{notaId} {
          allow read: if isMedico(clinicId);
          // Abrir una nota nueva = capturar dato nuevo → sujeto al paywall.
          // Firmar/editar un borrador YA abierto no, para no dejar una consulta
          // a medias sin poder cerrarla por un corte de pago a mitad del día.
          // REG-017 — TODA NOTA NACE EN BORRADOR. La firma es una ACCIÓN explícita
          // (borrador → firmada), no el estado inicial de un documento. Sin esto,
          // una nota podía nacer ya 'firmada' e inmutable sin historia previa,
          // saltándose la trazabilidad NOM-024.
          // La migración/importación histórica va por Admin SDK (omite reglas) y
          // debe quedar marcada como importada — nunca parecer firma nativa.
          allow create: if isMedico(clinicId) && clinicaPuedeEscribir(clinicId)
                        && request.resource.data.estado == 'borrador';
          /**
           * FIRMAR ES UN ACTO PERSONAL — nadie firma con la cédula de otro.
           *
           * La regla dejaba a CUALQUIER médico de la clínica poner
           * `estado: 'firmada'` en una nota cuyo `metadata.medicoId` es de otro.
           * Y el nombre y la cédula que se estampan en el papel salen de ese
           * campo. En un consultorio con dos médicos eso significa una nota
           * firmada a nombre de quien no la escribió, inmutable, y sin nada en el
           * documento que permita notarlo.
           *
           * Al firmar, el autor declarado tiene que ser QUIEN ESTÁ FIRMANDO. El
           * resto de las ediciones de un borrador siguen siendo del equipo
           * médico: una asistencia a cuatro manos sobre un borrador es normal;
           * la firma no.
           */
          allow update: if isMedico(clinicId) && resource.data.estado != 'firmada'
                        && (request.resource.data.estado != 'firmada'
                            || request.resource.data.metadata.medicoId == request.auth.uid);
          allow delete: if isMedico(clinicId) && resource.data.estado != 'firmada';

          // Versiones históricas de borradores (NOM-024 Art. 6.4 — trazabilidad de cambios).
          // INMUTABLES una vez creadas.
          match /versions/{versionId} {
            allow read: if isMedico(clinicId);
            allow create: if isMedico(clinicId);
            allow update, delete: if false;
          }

          // Adendas: corrección/aclaración a una nota YA FIRMADA sin alterar el
          // original (NOM-004). Se agregan pero NUNCA se editan ni se borran.
          /**
           * Adendas: corrección o aclaración sobre una nota YA FIRMADA sin tocar
           * el original. Es el ÚNICO mecanismo de corrección que existe sobre un
           * documento inmutable, así que tiene que acreditar tres cosas: quién,
           * cuándo y por qué. Se permitía crearlas sin validar ni un campo —el
           * autor venía del formulario y el motivo era opcional—, y una
           * corrección que no acredita autor ni motivo no es oponible a nadie.
           */
          match /adendas/{adendaId} {
            allow read: if isMedico(clinicId);
            allow create: if isMedico(clinicId)
                          && request.resource.data.autorUid == request.auth.uid
                          && request.resource.data.motivo is string
                          && request.resource.data.motivo.size() >= 3;
            allow update, delete: if false;
          }
        }

        /**
         * FORMULARIO PREVIO A LA CONSULTA (P-019) — SÓLO SERVIDOR PARA ESCRIBIR.
         *
         * Lo llena el paciente desde su enlace del portal, que NO es una sesión
         * de Firebase: la escritura pasa por `/api/portal`, que valida el token
         * HMAC y sella el paciente. Aquí se deja LEER al equipo del consultorio y
         * se cierra la escritura desde el navegador.
         *
         * Deliberado: si el paciente pudiera escribir directo, podría hacerlo
         * sobre el expediente de OTRO paciente de la misma clínica — el token es
         * lo único que ata la sesión a un `patientId`, y las reglas no lo ven.
         */
        /**
         * EL PAQUETE DE LA VISITA — lo que el paciente puede LEER de su consulta.
         *
         * V9 · PATIENT-COMPANION-001. Se compone de material ya firmado y nace
         * DRAFT; sólo llega a RELEASED con la aprobación de alguien autorizado.
         *
         * `write: if false` no es prudencia genérica: **liberar un paquete es un
         * acto de aprobación clínica**. Si el navegador pudiera escribir aquí,
         * cualquiera con el token del portal —que no es una sesión de Firebase y
         * estas reglas no lo ven— podría poner `estado: RELEASED` encima de un
         * borrador y enseñárselo a sí mismo como si lo hubiera aprobado su
         * médico. Lo escribe el servidor, que sí sabe quién aprueba.
         *
         * Y el paciente tampoco LEE de aquí: se lo sirve /api/portal después de
         * comprobar `visibleParaElPaciente`. `isMedico` es para el consultorio.
         */
        match /paquetes_visita/{docId} {
          allow read: if isMedico(clinicId);
          allow write: if false;
        }

        match /formularios_previos/{docId} {
          // `isMedico` y no `isMember`: aquí van motivo, medicamentos, alergias
          // y antecedentes — es secreto médico, igual que las notas. El guardián
          // de la matriz cazó esto cuando estaba en `isMember`.
          allow read: if isMedico(clinicId);
          allow write: if false;
        }

        /**
         * Historial de LABORATORIOS del paciente (valores extraídos de PDF/foto).
         * Secreto médico, igual que las notas: solo médico/admin. Cada doc es un
         * panel con su fecha; nunca se editan (se borra y se re-sube si hay error).
         */
        match /laboratorios/{labId} {
          allow read: if isMedico(clinicId);
          allow create, delete: if isMedico(clinicId);
          allow update: if false;
        }

        // Fotografía clínica seriada (dermatología, heridas, seguimiento).
        // Dato personal SENSIBLE: mismo secreto médico que las notas — la
        // asistente nunca tiene acceso. Se permite borrar (una toma mal hecha
        // o sin consentimiento debe poder eliminarse).
        match /fotos/{fotoId} {
          allow read, create, update, delete: if isMedico(clinicId);
        }

        /**
         * E0-06 — PHI CLÍNICO del paciente (alergias, antecedentes, valoración del
         * inmunocomprometido). Documento único `clinico/resumen`.
         *
         * Por qué una subcolección y no un candado sobre los campos: Firestore NO
         * autoriza por campo en LECTURA — o se lee el documento entero o no se lee.
         * Mientras `alergias` sea un campo de `patients/{docId}` (que es `isMember`
         * porque recepción necesita el directorio para agendar), NINGUNA regla puede
         * impedir que recepción las lea. El arreglo es de modelo de datos, no de
         * reglas. Las reglas no son recursivas: el `read: if isMember` de arriba NO
         * alcanza a esta subcolección, igual que no alcanza a `notas`.
         *
         * ESTADO: el bloque está en vigor, pero la MIGRACIÓN de los campos heredados
         * (Fases B y C del diseño de E0-06) espera la decisión D1 del médico dueño:
         * ¿la asistente puede CAPTURAR alergias en el alta aunque no pueda leerlas
         * después? Si la respuesta es «sí», create/update pasan a `isMember` y la
         * lectura se queda en `isMedico` (write-only). Hasta entonces, lo estricto.
         */
        match /clinico/{clinicoId} {
          allow read: if isMedico(clinicId);
          allow create, update: if isMedico(clinicId) && clinicaPuedeEscribir(clinicId);
          allow delete: if false;   // un antecedente no se borra desde el cliente
        }
      }
      match /waitlist/{docId} {
        allow read, write: if isMember(clinicId);
      }
      // Módulo de hospitalización — episodios de internamiento. Contienen datos
      // clínicos sensibles (diagnósticos, indicaciones, MAR, signos): solo
      // médicos/admin, igual que las notas (NOM-004 · secreto médico).
      match /internamientos/{intId} {
        // LECTURA: cualquier clínico hospitalario de la clínica.
        allow read: if isClinicoHospital(clinicId);
        // ESCRITURA del doc de internamiento (ingreso, egreso, indicaciones,
        // MAR, interconsultas, traslados, enfermería): SOLO por el servidor
        // (/api/hospital/mutar, Admin SDK) que valida el ROL POR ACCIÓN.
        // El cliente NO escribe directo → RBAC real, no de vista.
        allow create, update, delete: if false;
        /**
         * Signos vitales seriados — APPEND-ONLY DE VERDAD, no sólo en el código.
         *
         * El comentario anterior decía «AÑADEN (create) y CORRIGEN (update)», y
         * describía un modelo de corrección que la aplicación ABANDONÓ: desde la
         * decisión del médico dueño del 29-jul-2026, corregir un signo es
         * ANEXAR otro documento con `corrigeA` — «se implementa sin `update`: el
         * registro original nunca se toca», dice `corregirSignos`.
         *
         * O sea que la regla seguía permitiendo algo que ningún código hace y que
         * el diseño prohíbe. Y eso vacía la garantía entera: quien tuviera rol
         * clínico podía abrir la consola del navegador y sobreescribir una SpO₂
         * sin cadena de corrección, sin motivo y sin rastro — justo lo que
         * `motivoCorreccion` (v904) y la proyección `corrigeA` existen para
         * impedir. La regla de al lado ya lo dice: un cliente que escribe directo
         * tiene RBAC de vista, no real.
         *
         * Se cierra con la MISMA forma que ya se aceptó para `icu_observations`
         * (ICU-003, cuatro bloques más abajo): el `update` sólo puede tocar el
         * campo de CICLO DE VIDA, así que una toma se marca como corregida pero
         * sus MEDIDAS son inmutables. No es una política nueva: es la que el
         * médico dueño ya aprobó para el mismo dato un nivel más abajo.
         *
         * `delete: if false` se mantiene: un signo histórico no desaparece.
         */
        match /signos/{signoId} {
          allow read, create: if isClinicoHospital(clinicId);
          allow update: if isClinicoHospital(clinicId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estadoObservacion']);
          allow delete: if false;
        }

        // ══ ICU-002c/d — ESTANCIA UCI y ASIGNACIÓN DE CAMA ══
        //
        // MISMO patrón que el doc de internamiento, y por la misma razón: la
        // ESCRITURA va SOLO por el servidor (Admin SDK), que valida el rol POR
        // ACCIÓN. Un cliente que escribiera directo tendría RBAC de vista, no
        // real — puede abrir la consola del navegador y usar el SDK.
        //
        // POR QUÉ ESTO NO ES REDUNDANTE con el `match /{document=**}` de deny
        // total del final: ese comodín las cerraría a TODO, incluida la lectura
        // que la ficha necesita. Aquí se abre la lectura y sólo la lectura.
        //
        // Las reglas de Firestore son ADITIVAS (lección REG-014): se verificó que
        // ninguna regla más amplia alcance estas rutas antes de escribirlas.

        // Estancia en UCI dentro del episodio. Datos clínicos sensibles
        // (soportes activos, peso de dosificación, código de reanimación).
        match /icu_stays/{stayId} {
          allow read: if isClinicoHospital(clinicId);
          allow create, update, delete: if false;   // sólo servidor
        }

        // Observaciones de UCI — APPEND-ONLY, capturadas a pie de cama.
        //
        // A DIFERENCIA de icu_stays/bed_assignments, aquí el CLIENTE sí crea:
        // enfermería y el intensivista capturan durante el pase de visita, igual
        // que en `signos`. Obligarlas a pasar por el servidor añadiría latencia
        // en el único momento en que el dato se está tomando.
        //
        // EL APPEND-ONLY SE HACE CUMPLIR EN LA REGLA, no sólo en el código:
        // el `update` sólo puede tocar `estado`. Así una toma errónea se marca
        // (CORRECTED / ENTERED_IN_ERROR) pero sus MEDIDAS son inmutables: no se
        // puede reescribir un valor clínico haciéndolo pasar por una corrección.
        // La corrección de verdad es un documento NUEVO con `corrigeA`.
        //
        // `delete: if false` — una toma histórica no debe poder desaparecer.
        match /icu_observations/{obsId} {
          allow read, create: if isClinicoHospital(clinicId);
          allow update: if isClinicoHospital(clinicId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']);
          allow delete: if false;
        }

        // Asignación de cama — APPEND-ONLY con historia.
        // `delete: if false` es lo esencial: borrar una asignación destruiría la
        // trazabilidad de quién ocupó qué cama y cuándo, que es justo lo que esta
        // colección vino a crear. Cerrar una asignación es un UPDATE del servidor
        // (poner `hasta`), nunca un borrado.
        /**
         * REVISIÓN DE LA ENTREGA DE TURNO (charter §36: «siempre revisado por
         * médico»).
         *
         * Uno por episodio y por día. Se escribe desde la pantalla del pase, con
         * la sesión del médico que entrega — por eso `isClinicoHospital` y no
         * `servidor`: es un acto suyo, no del sistema.
         *
         * No se borra ni se reescribe: quién leyó la entrega y cuándo es
         * exactamente lo que se consulta cuando algo se pasó en el cambio de
         * turno.
         */
        match /handoff_revisiones/{diaId} {
          allow read: if isClinicoHospital(clinicId);
          allow create: if isClinicoHospital(clinicId)
                        && request.resource.data.por is string
                        && request.resource.data.por.size() > 0
                        && request.resource.data.en is string;
          allow update, delete: if false;
        }

        match /bed_assignments/{asigId} {
          allow read: if isClinicoHospital(clinicId);
          allow create, update, delete: if false;   // sólo servidor
        }
      }
      // Rol hospitalario por usuario. La ESCRITURA la controla médico/admin de la
      // clínica (isMedico), NO cualquier clínico: si esta colección interviene en
      // permisos, dejar que enfermería/farmacia/lab escriban su propio doc era un
      // vector de auto-escalada (reporte externo). La lectura sí es de todo el staff.
      match /hospital_roles/{uid} {
        allow read: if isClinicoHospital(clinicId);
        allow write: if isMedico(clinicId);
      }
      // Módulo de laboratorio — solicitudes y resultados (datos clínicos).
      // LEE todo el staff clínico. SOLICITA cualquiera de ellos (un médico o
      // enfermería puede pedir un estudio). Pero CARGAR o CORREGIR un resultado y
      // BORRAR una orden queda para quien lo emite: laboratorio o médico. Antes
      // enfermería y farmacia podían sobrescribir o borrar resultados que no
      // producen, sin bitácora — RBAC que era solo de vista.
      match /laboratorio/{ordenId} {
        allow read: if isClinicoHospital(clinicId);
        allow create: if isClinicoHospital(clinicId);
        allow update, delete: if isLabStaff(clinicId);
      }
      /**
       * Alertas hospitalarias (lab crítico, NEWS2, interconsulta).
       *
       * `delete: if false` ya impedía que una alerta crítica desapareciera. Pero
       * el `update` estaba abierto a TODO el documento, y el documento ES el
       * registro: `titulo`, `detalle` y `tipo` son el contenido clínico de la
       * alerta. Se podía reescribir «Deterioro clínico — NEWS2 9 (alto)» o
       * cambiarle el tipo desde la consola del navegador, y no quedaría rastro,
       * porque no hay un original con el que comparar.
       *
       * Borrarla estaba prohibido y vaciarla no: la misma alerta, dicha de otra
       * forma.
       *
       * Lo único que la aplicación actualiza es `leida` —una marca de bandeja, no
       * un juicio clínico—, así que es lo único que se permite. Misma forma que
       * `icu_observations` y `signos`.
       *
       * Si algún día se añade otro campo de ciclo de vida (`atendidaPor`, por
       * ejemplo), esta lista tiene que crecer A PROPÓSITO. Que falle en
       * desarrollo es la intención: es como se nota que se está tocando el
       * contenido de una alerta y no su bandeja.
       */
      match /hospital_alertas/{alertaId} {
        allow read, create: if isClinicoHospital(clinicId);
        allow update: if isClinicoHospital(clinicId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
        allow delete: if false;
      }
      // Catálogo de camas (inventario + ocupación). LEE todo el staff clínico;
      // ESCRIBE solo médico/admin (enfermería/farmacia/laboratorio no gestionan el
      // inventario — antes podían borrar/alterar camas: RBAC era solo de vista).
      match /camas/{camaId} {
        allow read: if isClinicoHospital(clinicId);
        allow write: if isMedico(clinicId);
      }
      // UNIDADES — el nombre lo pone el hospital, el TIPO lo entiende el software.
      //
      // Mismos permisos que `camas`: es inventario, no PHI. Lo lee todo el equipo
      // clínico del piso porque de esto depende en qué pantalla aparece cada
      // paciente; lo escribe el médico/admin, porque marcar una unidad como
      // «cuidados críticos» cambia el comportamiento clínico de la aplicación.
      match /unidades/{unidadId} {
        allow read: if isClinicoHospital(clinicId);
        allow write: if isMedico(clinicId);
      }
      // Configuración del consultorio. La asistente SÍ la necesita para agendar
      // (horarios, duraciones, sucursales), pero NO debe poder tocar la firma.
      //
      // Hallazgo de la auditoría del Núcleo: `config/main` guarda la firma y sello
      // del médico y su cédula profesional en el MISMO documento que los horarios.
      // Con `write: if isMember` cualquier recepción podía (a) leerse la firma y
      // (b), mucho peor, SUSTITUIRLA — y a partir de ahí toda receta impresa sale
      // con la firma que ella puso, a nombre del médico. En México eso alcanza para
      // recetar controlados. El repudio va en la dirección equivocada.
      //
      // Se bloquean por campo en vez de por documento para no romper el trabajo
      // diario de la asistente: puede seguir guardando la config, pero si el
      // guardado CAMBIA alguno de los campos de identidad profesional, se rechaza.
      // Si los reenvía sin cambios, diff() no los marca y pasa igual.
      function camposDeIdentidadMedica() {
        return ['firmaImagenDataUrl', 'firmaPorMedico', 'cedulaProfesional', 'especialidad'];
      }
      /**
       * REG-014 — LA FIRMA MÉDICA VIVE APARTE Y SOLO LA LEEN LOS MÉDICOS.
       *
       * En Firestore las reglas son ADITIVAS: si esta regla genérica concediera
       * lectura a `config/firma`, la regla estricta de abajo no serviría de nada
       * (basta con que UNA regla permita). Por eso se excluye aquí el documento
       * en vez de solo añadir una regla más específica.
       */
      match /config/firma {
        allow read, write: if isMedico(clinicId);
      }

      /**
       * Validación médica del dataset de dosificación.
       *
       * Una firma dice «yo, médico responsable, cotejé esta regla contra su
       * fuente». Sólo un MÉDICO puede firmarla: recepción o farmacia pueden
       * necesitar LEER qué está validado, pero validar una dosis es un acto
       * clínico y lleva nombre.
       *
       * Se permite `delete` a propósito, y es la única concesión: un médico tiene
       * que poder decir «me equivoqué al validar esto». Dejarlo marcado como
       * validado por no poder deshacerlo sería peor que borrarlo.
       */
      match /dosing_validations/{farmacoId} {
        allow read: if isMember(clinicId);
        allow write, delete: if isMedico(clinicId);
      }
      // Topes de dosis antimicrobiana cargados por el médico. Los lee todo el
      // equipo (la alerta se le enseña a quien prescribe), pero sólo un médico
      // los escribe: un tope de dosis es una decisión clínica.
      match /antimicrobial_limits/{limiteId} {
        allow read: if isMember(clinicId);
        allow write, delete: if isMedico(clinicId);
      }
      match /config/{docId} {
        allow read: if isMember(clinicId) && docId != 'firma';
        allow create: if isMedico(clinicId);
        // OJO con el paréntesis: el `isMember` va DENTRO de la segunda rama. Al
        // introducir este bloqueo por campo se escribió la condición sin él, y la
        // segunda rama del `||` quedó abierta a CUALQUIER usuario autenticado del
        // mundo: bastaba sacar el clinicId de la URL pública de reservas y escribir
        // la config de un consultorio ajeno sin tocar los campos de identidad.
        // Cerrar un hueco abrió otro más grande; por eso está anotado aquí.
        allow update: if isMedico(clinicId)
          || (isMember(clinicId)
              && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(camposDeIdentidadMedica()));
        allow delete: if isMedico(clinicId);
      }
      // Alta/baja de médicos y su cédula: solo médico/admin. `doctors` se publica
      // en el perfil público (/api/public/clinic), así que con write de isMember
      // la recepción podía dar de alta un médico inexistente de cara al paciente.
      match /doctors/{docId} {
        allow read: if isMember(clinicId);
        allow write: if isMedico(clinicId);
      }
      match /bot_sessions/{docId} {
        allow read, write: if false; // Admin SDK only
      }
      // Bajas (opt-out) de WhatsApp. La ESCRITURA es solo del servidor (el paciente
      // se da de baja por el bot). La LECTURA la habilita el equipo de la clínica
      // para NO ofrecer campañas de reactivación a quien pidió BAJA (cumplimiento).
      // El id del doc es el teléfono normalizado (52 + 10 dígitos).
      match /whatsapp_optout/{telefono} {
        allow read: if isMember(clinicId);
        allow write: if false; // Admin SDK (bot) only
      }
      // API keys de IA del consultorio + medidor de uso. NUNCA accesibles desde
      // el cliente: solo el servidor (Admin SDK) las lee/escribe.
      match /secretos/{docId} {
        allow read, write: if false; // Admin SDK only
      }
      // Bitácora de auditoría. Ya NO se escribe desde el cliente: pasa por
      // /api/auditoria/registrar, que toma la identidad del ID-token verificado y
      // la hora del servidor. Con `create: if isMember` y sin validar campos,
      // cualquier miembro podía insertar entradas con el correo y la fecha que
      // quisiera, o atribuirle un acceso a otro médico — una bitácora forjable por
      // el propio auditado no acredita nada.
      //
      // La lectura baja a isMedico: no contiene notas, pero sí patientId, notaId y
      // metadatos que revelan a quién se atendió y cuándo.
      match /audit_log/{docId} {
        allow read: if isMedico(clinicId);
        allow create, update, delete: if false;   // solo Admin SDK
      }
      /**
       * VOCABULARIO APRENDIDO DEL DICTADO (LEARN).
       *
       * Palabras que el médico corrigió a mano más de una vez, para sesgar al
       * reconocedor en la siguiente grabación.
       *
       * · SÓLO MÉDICO. No es PHI —es vocabulario clínico, y el motor excluye
       *   explícitamente las partes del nombre del paciente— pero revela cómo
       *   dicta el médico y qué fármacos maneja: no es de una asistente.
       * · BORRABLE. Si el sistema aprende algo torcido, el médico tiene que
       *   poder quitárselo; un aprendizaje que no se puede deshacer es peor que
       *   no aprender.
       * · Sin campos libres: se congela la forma para que nadie use esta
       *   colección de cajón de sastre.
       */
      match /asr_aprendizaje/{palabra} {
        allow read, delete: if isMedico(clinicId);
        allow create, update: if isMedico(clinicId)
          && request.resource.data.keys().hasOnly(['palabra', 'veces', 'oidoComo', 'actualizadoEn'])
          && request.resource.data.palabra is string
          && request.resource.data.veces is int
          && request.resource.data.veces > 0;
      }
      // Solicitudes ARCO (LFPDPPP) — los pacientes pueden CREAR (vía API pública),
      // los miembros de la clínica pueden leer/actualizar para resolver.
      // Nunca se pueden borrar (registro legal).
      match /arco_requests/{docId} {
        allow read: if isMember(clinicId);
        // Creación vía portal público (sin auth). Auditoría 2026-07 (P1): antes era
        // `if true` → cualquiera podía crear docs ARCO INMUTABLES (no se borran) en
        // CUALQUIER clínica, incluidas inexistentes, y spamear el registro legal. Se
        // constriñe: la clínica debe EXISTIR, el estado inicial fijo, y los campos de
        // texto acotados. No es rate-limit (eso va por API), pero corta el abuso masivo.
        /**
         * QUIEN LLEGA DE LA CALLE NO PUEDE SEÑALAR UN EXPEDIENTE.
         *
         * `patientId` no estaba constreñido, y el panel de Cumplimiento enseña
         * el botón «Ejecutar cancelación…» EXACTAMENTE cuando la solicitud trae
         * uno. Así que cualquiera desde internet podía crear una solicitud de
         * cancelación con el `patientId` de un paciente real de esa clínica —con
         * un nombre plausible en la tarjeta— y el panel le ofrecía al médico
         * suprimir ese expediente de un clic. Entre eso y la supresión sólo
         * quedaba la casilla de «verifiqué la identidad».
         *
         * Una solicitud pública dice quién dice ser el solicitante; NO dice a
         * qué expediente corresponde. Ligar el expediente es un acto de la
         * clínica, con la identificación delante (Art. 29 LFPDPPP), y por eso
         * sólo puede hacerlo un miembro.
         *
         * Y una solicitud pública tampoco puede declararse verificada a sí
         * misma: `identidadVerificada` nace en `false` y sólo el panel la sube.
         */
        allow create: if exists(/databases/$(database)/documents/clinics/$(clinicId))
          && request.resource.data.estado == 'recibida'
          && request.resource.data.clinicId == clinicId
          && request.resource.data.solicitante.nombre is string
          && request.resource.data.solicitante.nombre.size() <= 200
          && request.resource.data.descripcion is string
          && request.resource.data.descripcion.size() <= 5000
          && (
            isMember(clinicId)
            || (!('patientId' in request.resource.data.keys())
                && request.resource.data.get('identidadVerificada', false) == false
                && request.resource.data.get('origen', '') == 'portal-publico')
          );
        /**
         * LO QUE DIJO EL CIUDADANO NO SE TOCA.
         *
         * `delete: if false` está puesto porque esto es un REGISTRO LEGAL. Pero
         * el `update` estaba abierto a cualquier miembro y a todo el documento,
         * así que se podía **reescribir la solicitud misma**: cambiar
         * `descripcion` de «solicito la SUPRESIÓN de mis datos» a «solicito
         * acceso», marcarla resuelta, y el expediente legal diría que la clínica
         * cumplió con otra cosa.
         *
         * Reescribir es peor que borrar, porque el resultado parece íntegro.
         *
         * Y `origen` es lo que distingue una solicitud que llegó de la calle de
         * una que tecleó el consultorio: si un miembro puede voltearlo, toda la
         * cautela del `create` de arriba —que no deja al público señalar un
         * expediente ni declararse verificado— se puede deshacer después.
         *
         * Se congela lo que declaró el solicitante. Todo lo demás —estado,
         * resolución, quién resolvió, y ligar el expediente tras identificarlo,
         * que es un acto de la clínica (Art. 29 LFPDPPP)— sigue abierto.
         */
        allow update: if isMember(clinicId)
          && request.resource.data.solicitante == resource.data.solicitante
          && request.resource.data.tipo == resource.data.tipo
          && request.resource.data.descripcion == resource.data.descripcion
          && request.resource.data.fechaSolicitud == resource.data.fechaSolicitud
          && request.resource.data.clinicId == resource.data.clinicId
          && request.resource.data.get('origen', '') == resource.data.get('origen', '');
        allow delete: if false;
      }
      match /notification_logs/{docId} {
        allow read: if isMember(clinicId);
        allow create: if isMember(clinicId);
        allow update, delete: if false;
      }
      // Sucursales / sedes
      match /branches/{branchId} {
        allow read, write: if isMember(clinicId);
      }
      // Bloqueos de horario (vacaciones, ausencias)
      match /time_blocks/{blockId} {
        allow read, write: if isMember(clinicId);
      }
      // Inventario de farmacia interna. LEE/ESCRIBE solo staff clínico: el manejo
      // de medicamentos —incluidos controlados— no es de recepción/facturación.
      // Antes `isMember` dejaba a cualquier rol tocar el inventario. Además el
      // stock nunca puede quedar negativo (la aritmética que lo evitaba vivía
      // solo en el cliente; una escritura directa con cantidad<0 pasaba).
      match /farmacia/{itemId} {
        allow read: if isClinicoHospital(clinicId);
        allow write: if isClinicoHospital(clinicId)
          && (request.resource.data.get('cantidad', 0) is number)
          && request.resource.data.get('cantidad', 0) >= 0;
      }
      // Membresías de pacientes: catálogo de planes + asignaciones. Cualquier
      // miembro del consultorio (incl. asistente) las gestiona; el cobro real pasa
      // por la colección `cobros` (con sus propias reglas anti-fraude).
      match /membership_plans/{planId} {
        allow read, write: if isMember(clinicId);
      }
      match /memberships/{membershipId} {
        allow read, write: if isMember(clinicId);
      }
      // Learning Engine: preferencias de sugerencias POR MÉDICO (frecuencias por
      // categoría). Cada médico solo lee/escribe las suyas (uid == su propio uid);
      // no son datos del paciente, pero se aíslan por autor de todos modos.
      match /learning/{uid} {
        allow read, write: if isMember(clinicId) && request.auth.uid == uid;
      }
      // Movimientos de farmacia (entradas, salidas, ajustes). Inmutables, y el
      // autor lo sella el servidor: antes se podía crear un movimiento a nombre
      // de otro (el registro de controlados debe acreditar QUIÉN dispensó).
      match /farmacia_movimientos/{movId} {
        allow read: if isClinicoHospital(clinicId);
        allow create: if isClinicoHospital(clinicId)
          && request.resource.data.realizadoPor == request.auth.uid;
        allow update, delete: if false;  // movimientos inmutables — registro contable
      }
      // Cobros (registro contable)
      // Solo se permite crear y leer; cancelar = update con cancelado=true (no delete).
      /**
       * TAREAS CLÍNICAS — los cabos sueltos de la consulta.
       *
       * Viven a nivel de consultorio y no colgando del paciente, para poder
       * responder «¿qué queda pendiente HOY, de todos mis pacientes?» sin
       * recorrer los expedientes uno por uno.
       *
       * SECRETO MÉDICO: el título de una tarea es «Perfil tiroideo» junto al
       * nombre del paciente — eso es información clínica, así que sólo personal
       * clínico. La asistente no entra, igual que en las notas.
       *
       * NO SE BORRAN. Un pendiente que desaparece sin dejar rastro es
       * indistinguible de uno que nunca existió, y la constancia de que algo se
       * dejó de hacer es justo lo que hace falta si un día se revisa el caso. Se
       * cancela con motivo, que es un estado, no un borrado.
       */
      match /tareas_clinicas/{tareaId} {
        allow read: if isMedico(clinicId);
        allow create, update: if isMedico(clinicId) && clinicaPuedeEscribir(clinicId);
        allow delete: if false;
      }

      /**
       * Alertas críticas que NO se pudieron entregar. Las escribe SÓLO el
       * servidor (Admin SDK, que no pasa por estas reglas); desde el navegador
       * se leen y nada más. Que el propio consultorio pudiera borrarlas
       * convertiría «no llegó la alerta» en algo que se puede hacer desaparecer.
       */
      /**
       * Mensajes de WhatsApp que NO salieron. Mismo trato que las alertas: los
       * escribe sólo el servidor y no se borran desde el navegador. Un fallo de
       * entrega que se puede hacer desaparecer no sirve para nada.
       */
      match /whatsapp_no_entregados/{envioId} {
        allow read: if isMember(clinicId);
        allow write: if false;
      }

      match /alertas_no_entregadas/{alertaId} {
        allow read: if isMedico(clinicId);
        allow write: if false;
      }

      match /cobros/{cobroId} {
        allow read: if isMember(clinicId);
        /**
         * REG-015 — el AUTOR y el IMPORTE se validan aquí, no solo en el cliente.
         *
         * Antes bastaba con ser miembro: el navegador declaraba `creadoPor` con
         * lo que quisiera (unos llamadores mandaban correo, otros uid), así que
         * un cobro podía quedar atribuido a otra persona. Y no había piso de
         * monto: un negativo simulando devolución descuadra el corte en silencio.
         *
         * Las devoluciones son su propio tipo de transacción con traza a la
         * operación original (REFUND/CREDIT/ADJUSTMENT), no un signo menos.
         * El webhook de Stripe escribe con Admin SDK y no pasa por esta regla.
         */
        allow create: if isMember(clinicId)
                      && request.resource.data.creadoPor == request.auth.uid
                      && request.resource.data.monto is number
                      && request.resource.data.monto >= 0;
        /**
         * Un cobro es un registro contable: no se edita ni se borra, solo se
         * ANULA, y anular debe dejar huella. La regla anterior congelaba el monto
         * pero dejaba `cancelado` libre: cualquier miembro —de cualquier rol—
         * podía poner `cancelado:true` desde la consola, sin motivo ni autor, y el
         * cobro desaparecía de todos los cortes sin dejar rastro. En un archivo
         * que se describe a sí mismo como anti-fraude, eso era sustracción de
         * efectivo indetectable.
         *
         * Ahora una anulación SOLO es válida si:
         *  - el cobro no estaba ya cancelado (no se "re-anula" para pisar el autor)
         *  - se sella quién (== su propio uid, no se puede culpar a otro) y cuándo
         *  - se da un motivo no vacío
         *  - no se toca nada más del cobro (monto, método, concepto, fecha, y los
         *    vínculos con la cita y el paciente)
         * La otra rama permite vincular una factura sin cambiar nada más.
         */
        allow update: if isMember(clinicId)
          && request.resource.data.monto == resource.data.monto
          && request.resource.data.metodo == resource.data.metodo
          && request.resource.data.concepto == resource.data.concepto
          && request.resource.data.fecha == resource.data.fecha
          && request.resource.data.citaId == resource.data.citaId
          && request.resource.data.patientId == resource.data.patientId
          && request.resource.data.creadoPor == resource.data.creadoPor
          /**
           * EL MÉDICO DEL COBRO TAMBIÉN SE CONGELA.
           *
           * `medicoId` y `medicoNombre` NO estaban en esta lista, y la rama (b)
           * sólo exige que `facturaUuid` sea un string —vale la cadena vacía—.
           * O sea: cualquier miembro, incluida recepción, podía mandar un update
           * con `facturaUuid: ''` y el `medicoId` cambiado, y el cobro pasaba de
           * un médico a otro.
           *
           * Eso MUEVE DINERO: la base comisionable se acumula exactamente por
           * `medicoId`. Y a diferencia de la anulación, esta rama no deja ningún
           * campo de autoría, así que el traslado no se podía rastrear.
           *
           * `referenciaExterna` y `folio` entran por el mismo motivo: son los
           * únicos hilos que atan un cobro en línea con su operación en Stripe.
           */
          && request.resource.data.get('medicoId', '') == resource.data.get('medicoId', '')
          && request.resource.data.get('medicoNombre', '') == resource.data.get('medicoNombre', '')
          && request.resource.data.get('referenciaExterna', '') == resource.data.get('referenciaExterna', '')
          && request.resource.data.get('folio', '') == resource.data.get('folio', '')
          && (
            // (a) ANULAR: false/ausente → true, con autor, fecha y motivo.
            (resource.data.cancelado != true
              && request.resource.data.cancelado == true
              && request.resource.data.canceladoPor == request.auth.uid
              && request.resource.data.canceladoEn is string
              && request.resource.data.motivoCancelacion is string
              && request.resource.data.motivoCancelacion.size() > 0)
            /**
             * (b) VINCULAR FACTURA — y NADA MÁS.
             *
             * ── EL HUECO QUE TENÍA ─────────────────────────────────────────
             *
             * La exigencia de que el autor sea uno mismo
             * (`canceladoPor == request.auth.uid`) vive SÓLO en la rama (a), y
             * esa rama pide que el cobro no estuviera ya cancelado.
             *
             * Sobre un cobro YA ANULADO, esta rama aceptaba cualquier cambio
             * mientras `cancelado` siguiera igual: se podía reescribir
             * `canceladoPor`, `canceladoPorNombre`, `motivoCancelacion` y
             * `canceladoEn`. Cualquier miembro, de cualquier rol, desde la
             * consola del navegador.
             *
             * O sea: anular un cobro —quedarse con el efectivo— y después
             * **ponerle el nombre de un compañero**. Y el corte de caja lo
             * imprime tal cual desde v907, que es justo la pantalla que se hizo
             * para poder preguntarle a alguien. Un control que señala a la
             * persona equivocada es peor que no tenerlo.
             *
             * Ahora los cuatro campos de la anulación quedan congelados aquí:
             * esta rama existe para pegar un UUID de factura, no para reescribir
             * quién hizo qué.
             */
            || (request.resource.data.get('cancelado', false) == resource.data.get('cancelado', false)
              && request.resource.data.facturaUuid is string
              && request.resource.data.get('canceladoPor', '') == resource.data.get('canceladoPor', '')
              && request.resource.data.get('canceladoPorNombre', '') == resource.data.get('canceladoPorNombre', '')
              && request.resource.data.get('canceladoEn', '') == resource.data.get('canceladoEn', '')
              && request.resource.data.get('motivoCancelacion', '') == resource.data.get('motivoCancelacion', ''))
          );
        allow delete: if false;
      }
      // Reseñas: read publicadas o miembros leen todo; create solo desde servidor
      match /reviews/{reviewId} {
        /**
         * Solo lo PUBLICADO es público. Con `read: if true` se exponían también
         * las reseñas pendientes y las RECHAZADAS de cualquier clínica: justo lo
         * que un médico modera para que no se vea.
         */
        allow read: if isMember(clinicId) || resource.data.estado == 'publicada';
        /**
         * Crear solo desde el servidor. El comentario anterior daba por hecho que
         * bastaba con proteger la ruta /api, pero la regla no obliga a pasar por
         * ella: con `isAuth()`, cualquier cuenta —incluida la de prueba de otro
         * consultorio— podía escribir reseñas en la clínica que quisiera usando el
         * SDK cliente, sin token y sin cita. Quedaban en moderación, pero llenaban
         * la cola de otro.
         */
        allow create: if false;   // solo Admin SDK (/api/public/resena)
        allow update, delete: if isMember(clinicId);
      }
      // Chat interno (médico ↔ asistente)
      match /chat/{msgId} {
        allow read:   if isMember(clinicId);
        allow create: if isMember(clinicId) && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false; // los mensajes son inmutables
      }
      match /chat_reads/{uid} {
        allow read, write: if isAuth() && request.auth.uid == uid && isMember(clinicId);
      }
    }

    // Solicitudes de reseña (top-level — el paciente las lee con el token)
    match /clinic_review_requests/{token} {
      /**
       * GET público, LIST bloqueado — la misma distinción que ya se hace en
       * `clinic_invitations` aquí abajo, y por la misma razón.
       *
       * `read` cubre `get` Y `list`. Como esta colección es de primer nivel, con
       * `read: if true` cualquiera sin autenticarse podía pedir la colección
       * ENTERA y recibir, de todas las clínicas: nombre del paciente, nombre del
       * médico, clinicId y el token de reseña. Nombre de paciente asociado a un
       * médico y su especialidad es un dato de salud inferido (LFPDPPP), y encima
       * entregaba los tokens para suplantar reseñas.
       *
       * El token sigue funcionando como autorización, que era la intención: lo
       * que se quita es la enumeración, no el acceso por id.
       */
      allow get: if true;
      allow list: if false;
      // El creador debe ser MIEMBRO de la clínica que dice en el doc: con `isAuth()`
      // a secas, cualquier cuenta podía crear solicitudes con un `clinicId` ajeno
      // (spam cross-tenant en la cola de reseñas de otra clínica).
      allow create: if isMember(request.resource.data.clinicId);
      // El paciente SOLO puede marcarla usada (false→true); no puede quemarla sin
      // enviar ni alterar otros campos (antes `if true` dejaba corromperla).
      // REG-016: solo puede tocar `used`/`usedAt` (hasOnly). Antes, al marcar
      // usada, el flujo público podía mutar de paso CUALQUIER otro campo (nombre de
      // paciente/médico, etc.). El endpoint legítimo (Admin SDK) solo escribe esos dos.
      allow update: if resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.clinicId == resource.data.clinicId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt']);
      // Solo un miembro de la clínica DUEÑA puede borrarla. Antes `if isAuth()`
      // dejaba a cualquier usuario logueado (de otra clínica) borrar la solicitud de
      // reseña ajena si conocía/observaba el token.
      allow delete: if isMember(resource.data.clinicId);
    }

    // Invitaciones de clínica (top-level — el invitado las lee con el code)
    match /clinic_invitations/{code} {
      // LECTURA PÚBLICA del doc específico (necesario para que el invitado SIN
      // cuenta pueda ver la invitación antes de registrarse). Seguro porque:
      // - El code es aleatorio de 10 chars (32^10 ≈ 1.1 billones de combinaciones)
      // - La info expuesta no es sensible (nombre clínica + rol + nombre invitado opcional)
      // - LIST está bloqueado: nadie puede enumerar invitaciones, solo leer por id exacto
      allow get: if true;
      // LIST CERRADO — auditoría 2026-07 (P0). Antes era `if isAuth()` confiando en
      // que la query del cliente filtrara por clinicId, pero un cliente malicioso
      // puede enumerar TODAS las invitaciones de TODAS las clínicas (nombre de
      // clínica, invitado, rol y el código de invitación que permite UNIRSE a esa
      // clínica) — fuga cross-tenant + posible toma de cuenta (LFPDPPP). El cliente
      // no lista invitaciones en ninguna parte (el join usa Admin SDK por id exacto,
      // /api/clinic/unirse), así que cerrar `list` no rompe nada. `get` por id sigue.
      allow list: if false;
      // Crear: solo MÉDICO o ADMIN de la clínica destino (la secretaria/enfermería
      // ya NO puede invitar). Y para invitar con rol 'admin' hay que SER admin
      // (evita que un médico/secretaria fabrique un admin: escalada de privilegios).
      allow create: if isMedico(request.resource.data.clinicId)
        && (request.resource.data.role != 'admin' || isAdmin(request.resource.data.clinicId));
      // Actualizar: solo el invitado marca la invitación como usada. Se congela TODO
      // lo demás con hasOnly — sobre todo `role`: sin esto, en la aceptación se podía
      // elevar el rol de la invitación (p.ej. a 'admin') y un flujo futuro confiaría
      // en ese rol adulterado (auditoría maestra 2026-07 / reporte externo).
      allow update: if isAuth()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']);
      // Borrar (revocar): solo miembros de la clínica que creó la invitación
      allow delete: if isAuth()
        && exists(/databases/$(database)/documents/clinic_members/$(request.auth.uid))
        && get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId == resource.data.clinicId;
    }

    // Clinic memberships
    match /clinic_members/{uid} {
      // Lectura: el propio user, O cualquier miembro de la misma clínica
      // (necesario para que el panel "Equipo" liste compañeros)
      allow read: if isAuth() && (
        request.auth.uid == uid ||
        (resource != null && exists(/databases/$(database)/documents/clinic_members/$(request.auth.uid))
          && get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId == resource.data.clinicId)
      );
      // Listar el equipo se sirve por API con Admin SDK (/api/clinic/miembros),
      // filtrando por la clínica del solicitante. El `list` del cliente queda
      // CERRADO para evitar enumerar el directorio (correos/roles) de otras
      // clínicas (fuga cross-tenant · LFPDPPP). El `read` individual sigue arriba.
      allow list: if false;
      // Crear la PROPIA membresía solo es válido al CREAR tu clínica (eres su
      // ownerId). Unirse por invitación pasa por el servidor (/api/clinic/unirse,
      // Admin SDK). Así un usuario NO puede auto-asignarse admin en clínicas
      // ajenas (escalada cross-tenant que antes permitía `request.auth.uid == uid`).
      allow create: if isAuth() && (
        (request.auth.uid == uid
          && get(/databases/$(database)/documents/clinics/$(request.resource.data.clinicId)).data.ownerId == request.auth.uid)
        || isAdmin(request.resource.data.clinicId)
      );
      // Actualizar: solo el admin de la clínica ACTUAL, y el clinicId NO puede
      // cambiar — auditoría 2026-07 (P0): sin fijarlo, un admin podía reapuntar su
      // propia membresía (o la de otro) a OTRA clínica (escalada cross-tenant).
      allow update: if isAdmin(resource.data.clinicId)
        && request.resource.data.clinicId == resource.data.clinicId;
      // Eliminar = revocar acceso. Solo el admin de la clínica, y
      // nadie puede eliminar al admin original (creador) — esa restricción
      // se hace en UI por ahora.
      allow delete: if isAdmin(resource.data.clinicId) && request.auth.uid != uid;
    }

    // Google OAuth tokens (per-user) — access/refresh tokens = credencial persistente.
    // SOLO el servidor (Admin SDK): callback los escribe, sync/status/calendars los
    // leen, todo server-side. El cliente NUNCA los toca (el estado de conexión se
    // consulta por /api/calendar/status). Deny total cierra el robo por XSS de un
    // acceso persistente a Google Calendar (auditoría maestra 2026-07 / reporte externo).
    match /googleTokens/{uid} {
      allow read, write: if false;
    }

    // Facturación de la PLATAFORMA (nivel dueño) — pagos registrados por el
    // webhook de Stripe y bitácora de acciones del dueño. NUNCA accesibles desde
    // el cliente: solo el servidor (Admin SDK) y la consola /superadmin vía API.
    match /platform_payments/{payId} {
      allow read, write: if false; // Admin SDK only
    }
    match /platform_admin_log/{logId} {
      allow read, write: if false; // Admin SDK only
    }
    // Paquetes de la plataforma (combinaciones de módulos + precio) — los define
    // el dueño desde /superadmin vía API. Nunca desde el cliente.
    match /platform_packages/{pkgId} {
      allow read, write: if false; // Admin SDK only
    }
    match /platform_meta/{docId} {
      allow read, write: if false; // Admin SDK only
    }
    // Libro de costos de IA (tokens, modelo, latencia, precio). Lo escribe el
    // gateway con Admin SDK y lo lee /superadmin por API. NUNCA desde el cliente:
    // aunque no lleva nada clínico, revela el gasto de todos los consultorios.
    match /platform_cost_ledger/{eventoId} {
      allow read, write: if false; // Admin SDK only
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
