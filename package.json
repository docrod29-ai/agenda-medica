{
  "name": "agenda-medica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run pdf-worker && npm run version-sw && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:seguridad": "PLAYWRIGHT_LOCAL=1 PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test e2e/seguridad.spec.ts --project=chromium",
    "e2e:seguridad:enforce": "PLAYWRIGHT_LOCAL=1 PLAYWRIGHT_BASE_URL=http://localhost:3000 PLAYWRIGHT_ENFORCE=1 CSP_MODE=enforce playwright test e2e/seguridad.spec.ts --project=chromium",
    "e2e:seguridad:prod": "playwright test e2e/seguridad.spec.ts --project=chromium",
    "test:cobertura": "vitest run --coverage",
    "test:emulador": "firebase emulators:exec --only firestore --project demo-nexusmed-test \"vitest run --config vitest.emulator.config.ts\"",
    "a11y:paciente": "node scripts/design/medir-a11y-superficies-paciente.mjs --detalle",
    "respaldos:verificar": "node scripts/respaldos-verificar.mjs",
    "simulacro:respaldo": "npx tsx scripts/simulacro-respaldo.mjs",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:assets": "npx @capacitor/assets generate --iconBackgroundColor \"#0B0C0E\" --splashBackgroundColor \"#0B0C0E\"",
    "pdf-worker": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs",
    "version-sw": "node scripts/version-sw.mjs",
    "arnes:emuladores": "PATH=\"$(brew --prefix openjdk)/bin:$PATH\" firebase emulators:start --only auth,firestore --project demo-nexusmed-v10",
    "arnes:sembrar": "node scripts/design/sembrar-emulador.mjs",
    "arnes:dev": "NEXT_PUBLIC_FIREBASE_EMULATORS=1 NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-nexusmed-v10 NEXT_PUBLIC_FIREBASE_API_KEY=arnes-visual-v10 NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-nexusmed-v10.appspot.com NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000 NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:arnesvisual FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 next dev -p 3200",
    "arnes:trinquete-interfaz": "node scripts/carril-excelencia/trinquete-de-interfaz.mjs",
    "preview:equivalente": "node scripts/preview-equivalente.mjs",
    "compuerta:integracion": "node scripts/compuerta-integracion.mjs",
    "arnes:portal-destinos": "node scripts/carril-excelencia/destinos-del-portal.mjs",
    "arnes:consulta-grabando": "node scripts/carril-excelencia/consulta-grabando.mjs",
    "arnes:menos-movimiento": "node scripts/carril-excelencia/respeta-menos-movimiento.mjs",
    "arnes:conflictos-carriles": "node scripts/carril-excelencia/conflictos-entre-carriles.mjs",
    "arnes:documentos-encuentro": "node scripts/carril-excelencia/documentos-del-encuentro.mjs",
    "arnes:foco-visible": "node scripts/carril-excelencia/el-foco-se-ve.mjs",
    "arnes:acuse-puntero": "node scripts/carril-excelencia/el-control-acusa-el-puntero.mjs",
    "arnes:nada-tapa": "node scripts/carril-excelencia/nada-flotante-tapa-un-control.mjs",
    "arnes:estado-de-carga": "node scripts/carril-excelencia/el-hueco-dice-que-esta-cargando.mjs",
    "arnes:caida-de-datos": "node scripts/carril-excelencia/una-caida-no-borra-el-consultorio.mjs",
    "arnes:caida-parcial": "node scripts/carril-excelencia/una-caida-parcial-no-es-un-dia-libre.mjs",
    "arnes:cita-fuera-de-hora": "node scripts/carril-excelencia/la-cita-fuera-de-hora-se-ve.mjs",
    "arnes:consultorio-vacio": "node scripts/carril-excelencia/el-consultorio-recien-abierto.mjs",
    "arnes:texto-largo": "node scripts/carril-excelencia/el-texto-largo-cabe.mjs",
    "arnes:listas-largas": "node scripts/carril-excelencia/las-listas-largas.mjs",
    "arnes:tema-claro": "node scripts/carril-excelencia/el-tema-claro-tambien-cuenta.mjs",
    "e2e:telefono": "PLAYWRIGHT_LOCAL=1 PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test e2e/telefono.spec.ts --project=telefono-chromium",
    "simulacro:restauracion:firestore": "npx tsx scripts/simulacro-restauracion-firestore.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@stripe/stripe-js": "^9.6.0",
    "date-fns": "^4.2.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "googleapis": "^171.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.12",
    "pdfjs-dist": "^6.2.108",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.76.0",
    "stripe": "^22.1.1",
    "zod": "^4.4.3"
  },
  "//overrides": [
    "Correcciones de seguridad SIN tocar la version de next (16.2.12) ni ninguna mayor.",
    "Un override cambia la dependencia ANIDADA; el paquete padre se queda donde esta.",
    "sharp: next declara ^0.34.5 y 0.34.x arrastra 4 CVE heredadas de libvips.",
    "  0.35.3 pide Node >=20.9 (CI usa 22) y lo unico que next le llama es concurrency(), que no cambio.",
    "postcss: next trae 8.4.31 y el aviso cubre <=8.5.17. Procesa NUESTRO css en el build,",
    "  asi que la exposicion real es nula, pero el salto es de parche y sale gratis.",
    "NO se toca uuid: el aviso es de v3/v5/v6 con argumento buf, y google-gax y teeny-request",
    "  solo llaman v4() sin buf (verificado en node_modules). Subirlo de 9 a 11 seria cruzar dos",
    "  mayores por debajo de firebase-admin — o sea del login y de Firestore — a cambio de nada."
  ],
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.25",
    "nanoid": "^3.3.17",
    "@capacitor/cli": {
      "brace-expansion": "^5.0.9"
    }
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "firebase-tools": "15.25.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
