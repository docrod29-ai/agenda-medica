rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function memberClinicId() {
      return get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId;
    }

    function isMember(clinicId) {
      return isAuth() && memberClinicId() == clinicId;
    }

    function isAdmin(clinicId) {
      return isAuth() &&
        get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId == clinicId &&
        get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.role == 'admin';
    }

    // Clinic metadata (root)
    match /clinics/{clinicId} {
      allow read: if isMember(clinicId);
      allow create: if isAuth();
      allow update: if isAdmin(clinicId);
      allow delete: if false;

      match /appointments/{docId} {
        allow read, write: if isMember(clinicId);
      }
      match /patients/{docId} {
        allow read, write: if isMember(clinicId);

        // Expediente Clínico Electrónico — notas del paciente
        match /notas/{notaId} {
          allow read: if isMember(clinicId);
          allow create: if isMember(clinicId);
          // Solo se pueden editar/borrar borradores; las firmadas son inmutables (NOM-024)
          allow update: if isMember(clinicId) && resource.data.estado != 'firmada';
          allow delete: if isMember(clinicId) && resource.data.estado != 'firmada';

          // Versiones históricas de borradores (NOM-024 Art. 6.4 — trazabilidad de cambios).
          // INMUTABLES una vez creadas.
          match /versions/{versionId} {
            allow read: if isMember(clinicId);
            allow create: if isMember(clinicId);
            allow update, delete: if false;
          }
        }
      }
      match /waitlist/{docId} {
        allow read, write: if isMember(clinicId);
      }
      match /config/{docId} {
        allow read, write: if isMember(clinicId);
      }
      match /doctors/{docId} {
        allow read, write: if isMember(clinicId);
      }
      match /bot_sessions/{docId} {
        allow read, write: if false; // Admin SDK only
      }
      match /audit_log/{docId} {
        allow read: if isMember(clinicId);
        allow create: if isMember(clinicId);
        allow update, delete: if false;
      }
      // Solicitudes ARCO (LFPDPPP) — los pacientes pueden CREAR (vía API pública),
      // los miembros de la clínica pueden leer/actualizar para resolver.
      // Nunca se pueden borrar (registro legal).
      match /arco_requests/{docId} {
        allow read: if isMember(clinicId);
        allow create: if true;  // creación vía portal público (sin auth)
        allow update: if isMember(clinicId);
        allow delete: if false;
      }
      match /notification_logs/{docId} {
        allow read: if isMember(clinicId);
        allow create: if isMember(clinicId);
        allow update, delete: if false;
      }
      // Sucursales / sedes
      match /branches/{branchId} {
        allow read, write: if isMember(clinicId);
      }
      // Bloqueos de horario (vacaciones, ausencias)
      match /time_blocks/{blockId} {
        allow read, write: if isMember(clinicId);
      }
      // Inventario de farmacia interna
      match /farmacia/{itemId} {
        allow read, write: if isMember(clinicId);
      }
      // Movimientos de farmacia (entradas, salidas, ajustes)
      match /farmacia_movimientos/{movId} {
        allow read, create: if isMember(clinicId);
        allow update, delete: if false;  // movimientos inmutables — registro contable
      }
      // Cobros (registro contable)
      // Solo se permite crear y leer; cancelar = update con cancelado=true (no delete).
      match /cobros/{cobroId} {
        allow read, create: if isMember(clinicId);
        // Update solo para marcar cancelado o vincular factura (no para editar montos)
        allow update: if isMember(clinicId)
          && request.resource.data.monto == resource.data.monto
          && request.resource.data.metodo == resource.data.metodo
          && request.resource.data.concepto == resource.data.concepto
          && request.resource.data.fecha == resource.data.fecha;
        allow delete: if false;
      }
      // Reseñas: read publicadas o miembros leen todo; create solo desde servidor
      match /reviews/{reviewId} {
        allow read: if true;  // permite mostrar publicadas en página pública
        allow create: if isAuth();   // creación protegida adicional en route /api
        allow update, delete: if isMember(clinicId);
      }
      // Chat interno (médico ↔ asistente)
      match /chat/{msgId} {
        allow read:   if isMember(clinicId);
        allow create: if isMember(clinicId) && request.auth.uid == request.resource.data.senderId;
        allow update, delete: if false; // los mensajes son inmutables
      }
      match /chat_reads/{uid} {
        allow read, write: if isAuth() && request.auth.uid == uid && isMember(clinicId);
      }
    }

    // Solicitudes de reseña (top-level — el paciente las lee con el token)
    match /clinic_review_requests/{token} {
      allow read: if true;        // token funciona como autorización
      allow create: if isAuth();  // el médico genera la solicitud
      allow update: if true;      // el paciente marca used=true (validación en route)
      allow delete: if isAuth();
    }

    // Invitaciones de clínica (top-level — el invitado las lee con el code)
    match /clinic_invitations/{code} {
      // Cualquier usuario autenticado puede LEER por código (necesario para aceptar)
      allow read: if isAuth();
      // Crear: solo miembros de la clínica destino
      allow create: if isAuth()
        && exists(/databases/$(database)/documents/clinic_members/$(request.auth.uid))
        && get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId == request.resource.data.clinicId;
      // Actualizar: solo el invitado puede marcarla como usada (used: true + usedBy = su uid)
      allow update: if isAuth()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.clinicId == resource.data.clinicId;
      // Borrar (revocar): solo miembros de la clínica que creó la invitación
      allow delete: if isAuth()
        && exists(/databases/$(database)/documents/clinic_members/$(request.auth.uid))
        && get(/databases/$(database)/documents/clinic_members/$(request.auth.uid)).data.clinicId == resource.data.clinicId;
    }

    // Clinic memberships
    match /clinic_members/{uid} {
      allow read: if isAuth() && request.auth.uid == uid;
      allow create: if isAuth() && (
        request.auth.uid == uid ||
        isAdmin(request.resource.data.clinicId)
      );
      allow update: if isAdmin(resource.data.clinicId);
      allow delete: if false;
    }

    // Google OAuth tokens (per-user)
    match /googleTokens/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
