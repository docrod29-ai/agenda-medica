{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    // `docs/` es DOCUMENTACIÓN, no código de la aplicación. Las reproducciones
    // de la auditoría viven ahí y se ejecutan con su propia configuración de
    // vitest; comprobarlas como si fueran fuente convertía un artefacto de
    // auditoría en un bloqueo del build. Cada reproducción que se repara se
    // MUEVE a `src/__tests__/`, donde sí se comprueba y se sella.
    "docs"
  ]
}
