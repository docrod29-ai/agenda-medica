{
  "name": "agenda-medica",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:cobertura": "vitest run --coverage",
    "test:emulador": "firebase emulators:exec --only firestore --project demo-nexusmed-test \"vitest run --config vitest.emulator.config.ts\"",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:assets": "npx @capacitor/assets generate --iconBackgroundColor \"#0B0C0E\" --splashBackgroundColor \"#0B0C0E\""
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/camera": "^8.2.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@stripe/stripe-js": "^9.6.0",
    "date-fns": "^4.2.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "googleapis": "^171.4.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.12",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.76.0",
    "stripe": "^22.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@next/bundle-analyzer": "^16.2.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "15.24.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
